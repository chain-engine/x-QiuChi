# ============================================
# 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 优先级: 环境变量 > config.yaml > 代码默认值
# 所有配置项均可通过环境变量配置（与 config.yaml 一一对应）
# ============================================

# ------------ 运行环境 ------------
# development, testing, production
APP_ENV=development

# ------------ MCP 服务器配置 ------------
# 服务器名称
MCP_SERVER_NAME=QiuChi

# 传输层类型: stdio, sse, streamable-http
# - stdio: 用于 Claude Desktop 本地插件
# - sse: Server-Sent Events，用于 Web 应用
# - streamable-http: FastMCP 默认 HTTP 传输
MCP_TRANSPORT=streamable-http

# HTTP 监听地址
MCP_HOST=0.0.0.0

# HTTP 监听端口
MCP_PORT=8888

# JSON-RPC 响应格式（true/false）
MCP_JSON_RESPONSE=true

# 注意: 版本号不通过环境变量配置（MCP_VERSION 已废弃），
# 唯一事实源为 pyproject.toml

# ------------ 日志配置 ------------
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_LEVEL=INFO

# 日志输出目标: stderr, file, both
LOGGING_OUTPUT=both

# 日志文件路径（output 包含 file 时生效）
LOGGING_FILE_PATH=logs/x-QiuChi_{time:YYYY-MM-DD-HH}.log

# 日志轮转周期
LOGGING_ROTATION=1 hour

# 日志保留时长
LOGGING_RETENTION=7 days

# 日志格式
LOGGING_FORMAT=<green>{time:YYYY-MM-DD HH:mm:ss}</green> | <level>{level: <8}</level> | <cyan>{file.name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>

# ------------ 功能开关 ------------
FEATURES_MIDDLEWARE=true

# ------------ 插件配置 ------------
# 自动发现插件模块
PLUGIN_AUTO_DISCOVERY=true

# 插件发现路径（逗号分隔）
PLUGIN_DISCOVERY_PATHS=src.plugins

# 启用白名单（逗号分隔，空表示全部启用）
PLUGIN_ENABLED_PLUGINS=

# 禁用黑名单（逗号分隔）
PLUGIN_DISABLED_PLUGINS=

# ------------ 中间件配置 ------------
# 传输层 Bearer Token 认证
AUTH_ENABLED=false
# 有效 Token 列表（逗号分隔；AUTH_ENABLED=true 时必填）
AUTH_TOKENS=your_token_here

# ------------ OpenTelemetry 可观测性 ------------
TELEMETRY_ENABLED=true
TELEMETRY_SERVICE_NAME=x-QiuChi
# console | otlp
TELEMETRY_EXPORTER=console
# exporter=otlp 时填写，如 http://localhost:4318/v1/traces
TELEMETRY_OTLP_ENDPOINT=

# ------------ 外部 API / 业务密钥 ------------
# OpenWeatherMap API 密钥（天气查询工具）
OPENWEATHER_API_KEY=your_api_key_here

# LLM 配置（小米 MiMo，示例工具使用）
AI_LLM_PROVIDER=openai_compat
AI_LLM_BASE_URL=https://api.xiaomimimo.com/v1
AI_LLM_API_KEY=your_api_key_here
AI_LLM_MODEL=mimo-v2.6-pro

# MCP 客户端连接服务端使用的 Bearer Token（与服务端 AUTH_TOKENS 保持一致）
MCP_BEARER_TOKEN=your_token_here
